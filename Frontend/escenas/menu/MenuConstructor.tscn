[node name="TituloAyuda" type="Label" parent="CapaUI/ModalAyuda/CenterContainer/Panel/Margin/VBox" unique_id=1137496643]
layout_mode = 2
theme_override_colors/font_color = Color(0.35, 0.85, 1, 1)
