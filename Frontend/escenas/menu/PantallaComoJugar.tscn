theme_override_colors/font_color = Color(0.82, 0.86, 0.92, 1)
theme_override_font_sizes/font_size = 15
text = "Atrapa con tentáculos a las tropas rivales de sus dos carriles que NO son el suyo (nunca a la que tiene de frente), regenera su escudo al 100% y queda en guardia permanente. Las tropas atrapadas no pueden actuar. Todo termina cuando el escudo del Calamar vuelve a llegar a 0."
autowrap_mode = 2

