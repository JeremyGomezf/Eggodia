[node name="T" type="Label" parent="Root/Scroll/Margin/Contenido/Grid/Card13/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.85, 1, 1)
theme_override_font_sizes/font_size = 20
text = "13 · Las 5 series"

[node name="D" type="Label" parent="Root/Scroll/Margin/Contenido/Grid/Card13/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.82, 0.86, 0.92, 1)
theme_override_font_sizes/font_size = 15
text = "Las 17 tropas pertenecen a 5 series temáticas: Ajedrez, Medieval, Pacífico, Toons y Papeleo. En el Constructor de mazo eliges cuáles llevar; cada carta trae su habilidad única (por ejemplo el Enroque de la Torre, la Transmutación del Maguín o los Tentáculos del Calamar)."
autowrap_mode = 2

[node name="Card14" type="PanelContainer" parent="Root/Scroll/Margin/Contenido/Grid"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_styles/panel = SubResource("StyleBoxFlat_card")

[node name="VBox" type="VBoxContainer" parent="Root/Scroll/Margin/Contenido/Grid/Card14"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="T" type="Label" parent="Root/Scroll/Margin/Contenido/Grid/Card14/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.85, 1, 1)
theme_override_font_sizes/font_size = 20
text = "14 · Skins"

[node name="D" type="Label" parent="Root/Scroll/Margin/Contenido/Grid/Card14/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.82, 0.86, 0.92, 1)
theme_override_font_sizes/font_size = 15
text = "En la Tienda compras con monedas skins de Huevo (cambian el aspecto de tu trono) y skins de cartas — son puramente cosméticas, no afectan las estadísticas. Eliges tu skin activa en el menú; el rival usa una al azar."
autowrap_mode = 2

[node name="Tip" type="Label" parent="Root/Scroll/Margin/Contenido"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.75, 0.35, 1)
theme_override_font_sizes/font_size = 14
text = "Consejo: combina roles y series en el Constructor de mazo, y aprovecha la ventaja de Era y los hechizos en el momento justo."
horizontal_alignment = 1
autowrap_mode = 2
