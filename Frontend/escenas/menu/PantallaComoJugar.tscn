[node name="T" type="Label" parent="Root/Scroll/Margin/Contenido/Grid/Card4/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.85, 1, 1)
theme_override_font_sizes/font_size = 20
text = "4 · Hechizos"

[node name="D" type="Label" parent="Root/Scroll/Margin/Contenido/Grid/Card4/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.82, 0.86, 0.92, 1)
theme_override_font_sizes/font_size = 15
text = "Cinco hechizos/ardides, uno por partida cada uno: Curación (cura hasta 200 HP a una tropa tuya), Robar Carta (te llevas una carta de la mano rival), Veneno (50 de daño por turno durante 3 turnos a una tropa rival), Bloqueo (una tropa rival no puede actuar 2 turnos) y Encebollado (+100 de ataque y +100 de escudo a una tropa tuya)."
autowrap_mode = 2

[node name="Card5" type="PanelContainer" parent="Root/Scroll/Margin/Contenido/Grid"]
