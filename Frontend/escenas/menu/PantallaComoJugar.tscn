layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.85, 1, 1)
theme_override_font_sizes/font_size = 20
text = "3 · Habilidades con tiempo de espera"

[node name="D" type="Label" parent="Root/Scroll/Margin/Contenido/Grid/Card3/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.82, 0.86, 0.92, 1)
theme_override_font_sizes/font_size = 15
text = "Cada tropa necesita sobrevivir un número de turnos propios antes de poder usar su habilidad especial (2, 3 o 4 turnos según la carta). El botón de Habilidad aparece bloqueado hasta entonces — para el rival aplica exactamente igual."
autowrap_mode = 2

[node name="Card4" type="PanelContainer" parent="Root/Scroll/Margin/Contenido/Grid"]
