theme_override_font_sizes/font_size = 15
text = "Al desbloquear su habilidad, el Maguín convierte a la tropa rival con más vida en Tortuga (si tiene más escudo que vida) o Pez (en cualquier otro caso) durante 4 medios turnos. Al terminar, la tropa original regresa exactamente con la vida y el escudo que tenía."
autowrap_mode = 2

