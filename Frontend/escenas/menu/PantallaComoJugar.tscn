[node name="T" type="Label" parent="Root/Scroll/Margin/Contenido/Grid/Card12/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.85, 1, 1)
theme_override_font_sizes/font_size = 20
text = "12 · Roles de carta"

[node name="D" type="Label" parent="Root/Scroll/Margin/Contenido/Grid/Card12/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.82, 0.86, 0.92, 1)
theme_override_font_sizes/font_size = 15
text = "Cada tropa tiene un rol: Táctico (equilibrado y versátil), Asesino (mucho daño pero poca vida: golpea fuerte y cae rápido) y Coloso (mucha vida/escudo: aguanta y protege el carril). Tu mano se completa mezclando roles cada turno."
autowrap_mode = 2

[node name="Card13" type="PanelContainer" parent="Root/Scroll/Margin/Contenido/Grid"]
layout_mode = 2
