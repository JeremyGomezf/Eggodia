theme_override_font_sizes/font_size = 20
text = "5 · Energía y turnos"

[node name="D" type="Label" parent="Root/Scroll/Margin/Contenido/Grid/Card5/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.82, 0.86, 0.92, 1)
theme_override_font_sizes/font_size = 15
text = "Empiezas con 3 de energía por turno. Cada 3 turnos completos ganas +1 (hasta 5). Si tu HP baja del 30%, ganas 1 extra ese turno."
