layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.85, 0.95, 1)
theme_override_font_sizes/font_size = 17
text = "Eggodia es un juego de cartas por turnos: invocas tropas en 3 carriles, atacas y usas habilidades para bajar a cero el HP del huevo rival. Hay 17 tropas repartidas en 5 series, y cada carta tiene su propia habilidad. Cada turno tienes energía limitada — úsala con cabeza."
autowrap_mode = 2

