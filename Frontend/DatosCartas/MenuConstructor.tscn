[node name="TextoAyuda" type="RichTextLabel" parent="ModalAyuda/CenterContainer/Panel/Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/default_color = Color(0.9, 0.94, 1, 1)
theme_override_font_sizes/normal_font_size = 18
bbcode_enabled = true
text = "[b]1. Selector Izquierdo:[/b] Explora tus cartas por pestañas ([color=#4cb5ff]Tropas[/color] y [color=#ff5555]Ardid[/color]) o escribe en la lupa superior para buscar rápidamente.

[b]2. Previsualización:[/b] Haz clic en cualquier carta para ver su personaje animado en el centro e inspeccionar sus atributos completos a la derecha. ¡Toca al personaje en el centro para probar su ataque!

[b]3. Cofre del Mazo:[/b] Selecciona [b]8 cartas[/b] para completar tu mazo de combate. Haz clic sobre una carta dentro del cofre para retirarla.

[b]4. ¡A Batallar!:[/b] Cuando tu mazo tenga 8 cartas válidas, presiona el botón [color=#00e5ff]BATALLAR[/color] para iniciar el duelo."

